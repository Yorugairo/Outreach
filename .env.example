DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_DEFAULT_LOCATION_CODE=2840
DATAFORSEO_DEFAULT_LANGUAGE_CODE=en
DATAFORSEO_API_BASE=https://api.dataforseo.com
DATAFORSEO_TIMEOUT_SECONDS=30

# Loaded automatically by content/video_engine/cli.py from the repository-root .env.
# Existing process environment values take precedence.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Magnific media enhancement is disabled unless media-generate also receives
# --allow-paid and an explicit --max-cost-usd ceiling.
MAGNIFIC_API_KEY=
MAGNIFIC_BASE_URL=https://api.magnific.com
MAGNIFIC_TIMEOUT_S=60
MAGNIFIC_POLL_INTERVAL_S=2
MAGNIFIC_MAX_POLL_S=180
MAGNIFIC_STYLE_TRANSFER_COST_CEILING_USD=0.15
MAGNIFIC_FLUX_2_PRO_COST_CEILING_USD=0.10
# Stock search and previews use the same API key. Full-resolution downloads
# remain Asset-Gate controlled and fail closed unless the account entitlement
# has been verified for this acquisition.
MAGNIFIC_ACCOUNT_PLAN=unknown
MAGNIFIC_STOCK_DOWNLOADS_INCLUDED=false
MAGNIFIC_STOCK_DAILY_DOWNLOAD_LIMIT=100

# HyperFrames unit lane (P13)
HYPERFRAMES_PROJECT=
HYPERFRAMES_VERSION_PIN=
HYPERFRAMES_TIMEOUT_S=
