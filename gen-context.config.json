{
  "output": ".github/copilot-instructions.md",
  "outputs": [
    "copilot"
  ],
  "srcDirs": [
    "src",
    "scripts",
    "content/video_engine/scripts",
    "content/video_engine/src",
    "content/video_engine/tests",
    "content/video_engine/projects/systems-and-blowups/steel-and-paper"
  ],
  "exclude": [
    "node_modules",
    ".git",
    ".github",
    ".context",
    ".hermes",
    ".worktrees",
    "tests",
    "content",
    "docs",
    "artifacts",
    "runs",
    "scratch",
    "logs",
    "build",
    "dist",
    ".venv",
    "venv",
    "__pycache__",
    "__init__.py",
    "static",
    "migrations",
    "dataforseo_smoke_test.py"
  ],
  "maxDepth": 6,
  "maxSigsPerFile": 25,
  "maxTokens": 80000,
  "autoMaxTokens": false,
  "strategy": "full",
  "secretScan": true,
  "monorepo": false,
  "diffPriority": true,
  "depMap": true,
  "todos": true,
  "changes": true,
  "changesCommits": 5,
  "testCoverage": false,
  "impactRadius": false
}