{
  "output": ".github/copilot-instructions.md",
  "outputs": ["copilot"],
  "srcDirs": ["src", "scripts"],
  "exclude": [
    "node_modules",
    ".git",
    ".github",
    ".context",
    ".hermes",
    ".worktrees",
    "tests",
    "content",
    "docs",
    "artifacts",
    "runs",
    "scratch",
    "logs",
    "build",
    "dist",
    ".venv",
    "venv",
    "__pycache__"
  ],
  "maxDepth": 6,
  "maxSigsPerFile": 25,
  "maxTokens": 8000,
  "autoMaxTokens": false,
  "strategy": "full",
  "secretScan": true,
  "monorepo": false,
  "diffPriority": true,
  "depMap": true,
  "todos": true,
  "changes": true,
  "changesCommits": 5,
  "testCoverage": false,
  "impactRadius": false
}
