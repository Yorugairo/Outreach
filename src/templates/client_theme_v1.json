{"version":"client.default.v1","css":"body{font-family:Arial,sans-serif;color:#172033;line-height:1.5;max-width:980px;margin:0 auto;padding:36px}header{border-bottom:3px solid #2657a8;padding-bottom:24px;margin-bottom:28px}.eyebrow{color:#2657a8;font-size:12px;letter-spacing:.12em;font-weight:bold}h1{font-size:34px;margin:8px 0}.lede{font-size:18px;color:#536176}section{border:1px solid #d9e0eb;border-radius:8px;padding:20px;margin:18px 0}h2{margin-top:0;color:#2657a8}.card{background:#f5f7fb;padding:12px;margin:10px 0;border-radius:5px}.unknown{color:#6b7280;font-style:italic}table{border-collapse:collapse;width:100%}td,th{border-bottom:1px solid #d9e0eb;padding:8px;text-align:left}footer{color:#6b7280;font-size:12px;margin-top:30px}"}
