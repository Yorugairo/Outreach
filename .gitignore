# Secrets and local configuration
.env
.env.*
!.env.example
docs/local.env
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.venv/
venv/

# Build and editor state
build/
dist/
*.egg-info/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Hermes and isolated worktrees
.hermes/
.worktrees/
.context/

# Repository-local agent configuration is source. Generated context is not.
!.codex/
!.codex/config.toml
!.codex/agents/
!.codex/agents/*.toml
!.agents/
!.agents/skills/
!.agents/skills/**

# Derived SigMap context
/.github/copilot-instructions.md
/.sigmap-cache.json

# SigMap configuration is source, not generated context.
!/gen-context.config.json

# Runtime data and generated evidence
artifacts/
runs/
scratch/
logs/
*.log
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Generated pSEO output; source and corpus remain versioned
content/bjj-registry/output/
content/video_engine/runtime/

# Manim default cache/output when scenes are instantiated outside a job media_dir
media/

# Local Remotion bundler and benchmark caches
/.cache/
/.remotion/

# Regenerable P29 deck renders and local console bundles
/content/video_engine/projects/systems-and-blowups/sources/decks/teacher-stamped-production-visuals/*/slides/
/content/video_engine/projects/systems-and-blowups/sources/decks/teacher-stamped-production-visuals/*-teacher-stamped-slides.png
/content/video_engine/production_console/node_modules/
/content/video_engine/production_console/dist/

# Generated media: promoted vs provisional.
# Promoted catalogue assets ARE tracked — asset-catalog.v1.json binds them by
# sha256, so a missing file breaks resolution. Review and quarantine deliveries
# are provisional by definition and are replaced, not versioned.
content/video_engine/**/assets/review/
content/video_engine/**/assets/quarantine/
content/video_engine/**/assets/generated/review/
content/video_engine/**/assets/generated/quarantine/

# Runtime output is never hand-edited and never committed (AGENTS.md).
content/video_engine/runtime/
content/video_engine/**/runtime/

# Node dependencies, anywhere in the tree.
node_modules/

# Playwright CLI scratch output.
.playwright-cli/

# Rendered video is regenerable output, not source. One pilot's render folder
# alone is 5.7GB; committing these permanently bloats every clone.
content/video_engine/**/render/
*.mp4
*.mov
*.webm
