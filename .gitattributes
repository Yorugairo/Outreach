episode-1-claude-design-handoff/plates-1080/** -filter=lfs -diff=lfs -merge=lfs

# EVIDENCE SOURCES ARE BYTES, NOT TEXT. Each is hashed in its object every proof line; a line-ending
# conversion on checkout would break that sha256 and make a re-fetch look like a changed source.
content/video_engine/projects/**/evidence/sources/** -text

# HASH-BOUND PILOT ARTIFACTS ARE BYTES TOO (2026-09-13). The finance pilots pin sha256 of their compiled JSON, the animatic
# SVG assets and the asset manifests; the index holds LF, the pins are the LF hashes, and core.autocrlf=true checked them out
# CRLF - seven tests read as drift that was only line endings. Same rule as the evidence sources above.
content/video_engine/projects/**/pilots/** -text
content/video_engine/projects/**/animatic/** -text
content/video_engine/projects/**/*.svg -text

# Blender scene files are binary, including hash-bound diagnostic fixtures.
*.blend -text

# T4c native model descriptors, receipts and scene bindings pin exact JSON bytes.
# Preserve their LF content across Windows checkouts (core.autocrlf=true).
content/video_engine/assets/modeling/native/generalization/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
