{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nationalbjjregistry.com/schemas/technique-corpus.schema.json",
  "title": "BJJ Technique Corpus Record",
  "description": "A transcript-grounded technique record suitable for registry content and the video engine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "slug",
    "position",
    "belt",
    "category",
    "summary",
    "transcript",
    "metadata",
    "related"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "position": {
      "type": "string",
      "minLength": 1
    },
    "belt": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "transcript": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "common_errors",
        "key_terms"
      ],
      "properties": {
        "common_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "key_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "slug"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "position": {
            "type": "string",
            "minLength": 1
          },
          "belt": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
