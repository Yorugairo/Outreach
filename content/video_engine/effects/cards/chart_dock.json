      ],
      "does": "A procedure table lands row by row on the narration: each question types on letter by letter, the other cells fade in, and the answer cells take a chisel-edged marker sweep; re-docked for under 12 s it replays as a recap.",
      "when": "the sentence walks a PROCEDURE (a question, its answer) - rows land keyed to the narration",
      "when_source": "docs/content-video-engine/CAPABILITIES.md:189",
      "author": {
        "key": "`checklist: {head: [...], rows: [{cells: [...], colors?}]}` in the dock asset's .series.json",
        "example": "(\"ev-test-scorecard-v1\",0,492.3,543.0)",
        "example_source": "content/video_engine/projects/systems-and-blowups/steel-and-paper/SHOT-TABLE-F.py:114",
        "check": "chart"
      },
      "phases": [
        {
          "name": "fit",
          "does": "the columns auto-fit once: natural widths measured, slack spread, over-long cells squeezed by textLength",
          "trigger": "the first drawChart tick",
          "dials": {
            "PAD_px": "26"
          }
        },
        {
          "name": "row lands",
          "does": "each row starts on its narration-keyed delay",
          "trigger": "rows[i].delay from narration_key_delays; RECAP (dock hold < 12 s): i x 0.8 s",
          "dials": {
            "recap_hold_s": "12",
            "recap_row_step_s": "0.8"
          }
        },
        {
          "name": "question types",
          "does": "cell 0 types on character by character",
          "trigger": "row start + 0",
          "dials": {
            "char_s": "0.045",
            "fade_s": "0.35"
          }
        },
        {
          "name": "cells fade",
          "does": "cells 1-3 fade in on their offsets",
          "trigger": "row start + [0.6, 1.0, 1.6] s (recap [0.25, 0.45, 0.7])",
          "dials": {
            "fade_s": "0.35"
          }
        },
        {
          "name": "highlight sweep",
          "does": "answer cells (column index >= 2) take a cap-height marker band swept left to right behind the text, its leading edge chisel-tilted",
          "trigger": "that cell's offset",
          "dials": {
            "sweep_s": "0.55",
            "ease": "cubic out",
            "skewX_deg": "-7",
            "band_h_px": "30",
            "band_opacity": "0.28 (a K-M ink layer when kinetics km_ink)",
            "default_cell_colours": "[\"#f4f6f8\", \"#dce3ea\", \"#3bc9b0\", \"#ff8a8c\"]"
          }
        }
      ],
      "blends": [
        {
          "source": "remotion-ui marker highlight (cap-height band, chisel-tilt edge)",
          "became": "highlight sweep",
          "record": "docs/content-video-engine/samples/scene-evidence-engine.mjs:3583",
