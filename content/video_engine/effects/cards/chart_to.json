    {
      "id": "chart_to:recast",
      "axis": "chart_to",
      "token": "recast",
      "title": "The recast chart-to verb",
      "aliases": [
        {
          "name": "`recast` keyed: n lines become n bars",
          "source": "docs/content-video-engine/CAPABILITIES.md:108"
        },
        {
          "name": "the hand-over",
          "source": "content/video_engine/scripts/build_scene_timeline_f.py:273"
        }
      ],
      "does": "The same data changes form on the page - lines become bars by series, by tag, by data, or by a hand-over.",
      "when": null,
      "when_source": null,
      "author": {
        "key": "chart_to {\"to\": \"recast\"}",
        "example": "{'kind': 'chart_to', 'at': 50.3, 'dur': 1.4, 'to': 'recast', 'state': 1}",
        "example_source": "content/video_engine/projects/systems-and-blowups/tokyo-tea-break/SHOT-TABLE-SHORT.py:7",
        "check": "species"
      },
      "phases": [
        {
          "name": "words erase",
          "does": "the standing sub and source erase",
          "trigger": "the chart_to's `at`",
          "dials": {
            "ERASE_S": "0.4"
          }
        },
        {
          "name": "standing chart leaves",
          "does": "plain: the chart un-draws on segEase while its axes hand over; keyed: marks tween (tags appear over KEYED.TAG first); data-keyed: the data travel to their bars on a clock of at least MIN_S",
          "trigger": "`at`, over `dur`",
          "dials": {
            "TAG": "0.3",
            "MIN_S": "1.6"
          }
        },
        {
          "name": "new words write",
          "does": "the arriving state's sub and source write",
          "trigger": "ERASE_S after `at`"
        },
        {
          "name": "target builds",
          "does": "plain recast: the named state draws on by its own build envelope",
          "trigger": "at + dur",
          "dials": {
            "BUILD": "3.0"
          }
        }
      ],
