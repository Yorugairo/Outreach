{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "finance_semantic_beat_ledger.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "source_bindings",
    "timing",
    "chapters",
    "beats",
    "chapter_boundary_review",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "finance_semantic_beat_ledger.v1"},
    "episode_id": {"type": "string", "minLength": 1},
    "source_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narration_manifest", "word_timing", "script", "claim_ledger"],
      "properties": {
        "narration_manifest": {"$ref": "#/definitions/file_binding"},
        "word_timing": {"$ref": "#/definitions/file_binding"},
        "script": {"$ref": "#/definitions/file_binding"},
        "claim_ledger": {"$ref": "#/definitions/file_binding"}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "word_count",
        "duration_s",
        "first_word_start_s",
        "last_word_end_s",
        "canonical_word_sequence_sha256"
      ],
      "properties": {
        "word_count": {"type": "integer", "minimum": 1},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "first_word_start_s": {"type": "number", "minimum": 0},
        "last_word_end_s": {"type": "number", "exclusiveMinimum": 0},
        "canonical_word_sequence_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/chapter"}
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/beat"}
    },
    "chapter_boundary_review": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/chapter_review"}
    },
    "artifact_hash": {"$ref": "#/definitions/sha256"}
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_id",
        "chapter_index",
        "title",
        "start_word_index",
        "end_word_index",
        "start_s",
        "end_s",
        "claim_scope_refs"
      ],
      "properties": {
        "chapter_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "chapter_index": {"type": "integer", "minimum": 0},
        "title": {"type": "string", "minLength": 1},
        "start_word_index": {"type": "integer", "minimum": 0},
        "end_word_index": {"type": "integer", "minimum": 0},
        "start_s": {"type": "number", "minimum": 0},
        "end_s": {"type": "number", "exclusiveMinimum": 0},
        "claim_scope_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "noun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "canonical", "start_word_index", "end_word_index"],
      "properties": {
        "surface": {"type": "string", "minLength": 1},
        "canonical": {"type": "string", "minLength": 1},
        "start_word_index": {"type": "integer", "minimum": 0},
        "end_word_index": {"type": "integer", "minimum": 0}
      }
    },
    "verb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "lemma", "word_index"],
      "properties": {
        "surface": {"type": "string", "minLength": 1},
        "lemma": {"type": "string", "pattern": "^[a-z-]+$"},
        "word_index": {"type": "integer", "minimum": 0}
      }
    },
    "visual_job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description"],
      "properties": {
        "kind": {
          "enum": [
            "establish",
            "compare",
            "constrain",
            "transfer",
            "transform",
            "reveal",
            "countercase",
            "payoff"
          ]
        },
        "description": {"type": "string", "minLength": 12}
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beat_id",
        "chapter_id",
        "chapter_index",
        "local_index",
        "start_word_index",
        "end_word_index",
        "start_s",
        "end_s",
        "excerpt",
        "boundary_kind",
        "split_rationale",
        "active_nouns",
        "causal_verb",
        "claim_refs",
        "viewer_understanding",
        "visual_job",
        "needs_deterministic_fact_surface"
      ],
      "properties": {
        "beat_id": {"type": "string", "pattern": "^cbm-semantic-beat-[0-9]{2}-[0-9]{3}$"},
        "chapter_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "chapter_index": {"type": "integer", "minimum": 0},
        "local_index": {"type": "integer", "minimum": 1},
        "start_word_index": {"type": "integer", "minimum": 0},
        "end_word_index": {"type": "integer", "minimum": 0},
        "start_s": {"type": "number", "minimum": 0},
        "end_s": {"type": "number", "exclusiveMinimum": 0},
        "excerpt": {"type": "string", "minLength": 1},
        "boundary_kind": {"enum": ["sentence_terminal", "compound_clause", "chapter_end"]},
        "split_rationale": {"type": ["string", "null"]},
        "active_nouns": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/noun"}},
        "causal_verb": {"$ref": "#/definitions/verb"},
        "claim_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "viewer_understanding": {"type": "string", "minLength": 12},
        "visual_job": {"$ref": "#/definitions/visual_job"},
        "needs_deterministic_fact_surface": {"type": "boolean"}
      }
    },
    "chapter_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_id",
        "start_word_index",
        "end_word_index",
        "start_excerpt",
        "end_excerpt",
        "status",
        "notes"
      ],
      "properties": {
        "chapter_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "start_word_index": {"type": "integer", "minimum": 0},
        "end_word_index": {"type": "integer", "minimum": 0},
        "start_excerpt": {"type": "string", "minLength": 1},
        "end_excerpt": {"type": "string", "minLength": 1},
        "status": {"const": "manually_reviewed"},
        "notes": {"type": "string", "minLength": 8}
      }
    }
  }
}
