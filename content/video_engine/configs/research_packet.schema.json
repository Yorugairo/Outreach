{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://outreach-program.internal/schemas/research-packet.v1.json",
  "title": "History Documentary Research Packet v1",
  "description": "Evidence ledger for historical narration. Research sources never become renderer assets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "episode_id", "sources", "citations", "claims", "reviewer_state"],
  "properties": {
    "schema_version": { "const": "research_packet.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "episode_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "thesis": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "ready_for_review", "approved", "rejected", "blocked"] },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/source" }
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/citation" }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/claim" }
    },
    "research_questions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "reviewer_state": { "$ref": "#/definitions/reviewerState" },
    "review": { "$ref": "#/definitions/reviewerState" },
    "notes": { "type": "string" },
    "artifact_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "source_kind", "locator"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "type": "string", "minLength": 1 },
        "source_kind": { "type": "string", "enum": ["primary", "scholarly", "museum_archive", "authoritative_secondary", "secondary", "public_record", "interview", "study", "reference_study", "consultant", "consultant_outline", "creative_study"] },
        "kind": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "publication_date": { "type": "string", "minLength": 1 },
        "accessed_at": { "type": "string", "minLength": 1 },
        "independence_group": { "type": "string", "minLength": 1 },
        "source_quality": { "type": ["integer", "number", "string"], "minimum": 1, "maximum": 5 },
        "quality": { "type": ["integer", "number", "string"], "minimum": 1, "maximum": 5 },
        "role": { "type": "string", "enum": ["factual", "context", "study", "consultant"] },
        "is_factual_source": { "type": "boolean" },
        "factual_eligible": { "type": "boolean" },
        "render_eligible": { "const": false },
        "notes": { "type": "string" }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "source_id": { "$ref": "#/definitions/id" },
        "locator": { "type": "string", "minLength": 1 },
        "quote_locator": { "type": "string", "minLength": 1 },
        "page": { "type": ["integer", "string"], "minimum": 1 },
        "chapter": { "type": "string", "minLength": 1 },
        "accessed_at": { "type": "string", "minLength": 1 },
        "excerpt": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "citation_ids"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "text": { "type": "string", "minLength": 1 },
        "citation_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/id" }, "uniqueItems": true },
        "source_ids": { "type": "array", "items": { "$ref": "#/definitions/id" }, "uniqueItems": true },
        "contested": { "type": "boolean" },
        "status": { "type": "string", "enum": ["supported", "contested", "inference", "open_question", "rejected"] },
        "direct_quote": { "type": "boolean" },
        "quote": { "type": "string", "minLength": 1 },
        "direct_quote_text": { "type": "string", "minLength": 1 },
        "quote_locator": { "type": "string", "minLength": 1 },
        "narration": { "type": "string", "minLength": 1 },
        "qualified_narration": { "type": "string", "minLength": 1 },
        "qualification": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "reviewerState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "in_review", "approved", "rejected", "blocked"] },
        "reviewed_by": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
