{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://outreach-program.internal/schemas/hyperframes_unit.schema.json",
  "title": "HyperframesUnit",
  "description": "Asset-ID-only contract for the HyperFrames short/caption unit lane. Canonical narration word timings are the clock; plates bind approved manifest assets by id + sha256. No renderer paths ever appear in this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "unit_id",
    "unit_kind",
    "project_id",
    "manifest_path",
    "narration",
    "plates",
    "layout",
    "output"
  ],
  "properties": {
    "schema_version": {
      "const": "hyperframes_unit.v1"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "unit_kind": {
      "type": "string",
      "enum": [
        "vertical_short",
        "title_card",
        "caption_unit",
        "animatic_preview"
      ]
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "manifest_path": {
      "type": "string",
      "description": "Repo-relative path to the approved asset manifest this unit binds against. The service enforces review status, membership, and sha256."
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_hash",
        "words"
      ],
      "properties": {
        "canonical_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "words": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "w",
              "start_s",
              "end_s"
            ],
            "properties": {
              "w": {
                "type": "string",
                "minLength": 1
              },
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "plates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "start_s",
          "end_s"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "captions": {
      "type": "boolean",
      "default": true
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect"
      ],
      "properties": {
        "aspect": {
          "type": "string",
          "enum": [
            "landscape",
            "vertical"
          ]
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#0F0F12"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quality",
        "max_duration_s"
      ],
      "properties": {
        "quality": {
          "type": "string",
          "enum": [
            "draft",
            "standard",
            "high"
          ]
        },
        "format": {
          "const": "mp4",
          "default": "mp4"
        },
        "max_duration_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 178
        }
      }
    },
    "preview_intent": {
      "const": "quarantined_review_preview",
      "description": "Explicit opt-in for an animatic_preview to reference review_only assets. Output is quarantined, stamped provisional, and no publish path may read it. Meaningless and rejected on any other unit kind."
    }
  }
}
