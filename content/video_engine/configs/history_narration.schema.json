{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nationalbjjregistry.com/schemas/history_narration.v1.json",
  "title": "History documentary canonical narration",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "episode_id",
    "source_storyboard_hash",
    "research_hash",
    "segments",
    "total_words",
    "total_chars"
  ],
  "properties": {
    "schema_version": {"const": "history_narration.v1"},
    "episode_id": {"type": "string", "minLength": 1},
    "source_storyboard_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "research_hash": {"type": "string", "minLength": 1},
    "target_duration_s": {"type": "number", "exclusiveMinimum": 0},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["segment_id", "scene_id", "chapter_id", "text", "claim_refs", "citation_refs"],
        "properties": {
          "segment_id": {"type": "string", "minLength": 1},
          "scene_id": {"type": "integer", "minimum": 1},
          "chapter_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "claim_refs": {"type": "array", "items": {"type": "string"}},
          "citation_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "total_words": {"type": "integer", "minimum": 1},
    "total_chars": {"type": "integer", "minimum": 1}
  }
}
