{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://outreach-program.internal/schemas/production-profile.v1.json",
  "title": "Research-only production profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "source_identity",
    "render_policy",
    "cloneable_grammar",
    "reserved_identity",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": { "const": "production_profile.v1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "studied_works"],
      "properties": {
        "channel": { "type": "string", "minLength": 1 },
        "studied_works": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reference_id", "title"],
            "properties": {
              "reference_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{6,20}$"
              },
              "title": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "render_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "render_eligible",
        "source_media_allowed",
        "source_assets_allowed"
      ],
      "properties": {
        "render_eligible": { "const": false },
        "source_media_allowed": { "const": false },
        "source_assets_allowed": { "const": false }
      }
    },
    "cloneable_grammar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition",
        "motion_economics",
        "editing",
        "visual_hierarchy",
        "sound_hierarchy"
      ],
      "properties": {
        "composition": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "motion_economics": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "editing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mean_cut_interval_s", "patterns"],
          "properties": {
            "mean_cut_interval_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "patterns": {
              "type": "array",
              "minItems": 2,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "visual_hierarchy": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "sound_hierarchy": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reserved_identity": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
