{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editor_component_catalog.v1",
  "title": "Closed Editor Component Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "catalog_version",
    "remotion_version",
    "components",
    "presets",
    "catalog_hash",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "editor_component_catalog.v1"},
    "catalog_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "catalog_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "remotion_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/component"}
    },
    "presets": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/preset"}
    },
    "catalog_hash": {"$ref": "#/$defs/sha256"},
    "artifact_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "stringList": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "label", "kind", "adapter_id", "source", "version", "deterministic", "allowed_prop_keys", "preset_ids"],
      "properties": {
        "component_id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 256},
        "kind": {"enum": ["caption", "text", "annotation", "teacher_stamp", "world_plate", "evidence_plate", "shape", "chart", "remotion_bit"]},
        "adapter_id": {"$ref": "#/$defs/id"},
        "source": {"enum": ["builtin", "remotion_bits"]},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "package_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "package_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "deterministic": {"const": true},
        "allowed_prop_keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/propKey"}
        },
        "preset_ids": {"$ref": "#/$defs/stringList"}
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset_id", "component_id", "label", "props"],
      "properties": {
        "preset_id": {"$ref": "#/$defs/id"},
        "component_id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 256},
        "props": {"$ref": "#/$defs/props"}
      }
    },
    "propKey": {
      "enum": [
        "style_id",
        "font_size",
        "line_height",
        "color",
        "background_color",
        "variant",
        "stroke_color",
        "opacity",
        "x",
        "y",
        "scale",
        "rotation",
        "z",
        "asset_role",
        "motion_recipe",
        "text",
        "durationInFrames",
        "style",
        "fontSize",
        "blurAmount",
        "staggerFrames",
        "distance",
        "typeSpeedFrames",
        "showCursor",
        "from",
        "to",
        "prefix",
        "postfix",
        "decimals",
        "items",
        "backgroundColor",
        "columns",
        "images",
        "assetMap",
        "tileCount",
        "cards",
        "scaleFrom",
        "scaleTo",
        "direction"
      ]
    },
    "props": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "additionalProperties": false,
      "properties": {
        "style_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "variant": {"type": "string", "minLength": 1, "maxLength": 128},
        "font_size": {"type": "number", "exclusiveMinimum": 0, "maximum": 512},
        "line_height": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
        "padding": {"type": "number", "minimum": 0, "maximum": 512},
        "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "background_color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "stroke_color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "x": {"type": "number", "minimum": -2, "maximum": 2},
        "y": {"type": "number", "minimum": -2, "maximum": 2},
        "scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
        "rotation": {"type": "number", "minimum": -360, "maximum": 360},
        "z": {"type": "integer", "minimum": -100, "maximum": 100},
        "asset_role": {"enum": ["world", "evidence", "annotation", "teacher_stamp"]},
        "motion_recipe": {"enum": ["hold", "marker_reveal", "slow_push", "evidence_slide", "whiteboard_trace"]}
      }
    }
  }
}
