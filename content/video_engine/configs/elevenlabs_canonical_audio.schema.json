{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nationalbjjregistry.com/schemas/elevenlabs_canonical_audio.v1.json",
  "title": "Canonical ElevenLabs episode audio",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "status",
    "provider",
    "episode_id",
    "narration_hash",
    "voice_id",
    "audio_path",
    "words_path",
    "duration_s",
    "blocks"
  ],
  "properties": {
    "schema_version": {"const": "elevenlabs_canonical_audio.v1"},
    "status": {"enum": ["awaiting_audio", "ready"]},
    "provider": {"const": "elevenlabs"},
    "episode_id": {"type": "string", "minLength": 1},
    "narration_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "storyboard_hash": {"type": "string", "minLength": 1},
    "voice_id": {"type": "string", "minLength": 1},
    "audio_path": {"type": "string", "minLength": 1},
    "words_path": {"type": "string", "minLength": 1},
    "duration_s": {"type": "number", "exclusiveMinimum": 0},
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "start_s", "end_s", "audio_path", "sha256", "duration_s", "word_timings"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "start_s": {"type": "number", "minimum": 0},
          "end_s": {"type": "number", "exclusiveMinimum": 0},
          "audio_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "duration_s": {"type": "number", "exclusiveMinimum": 0},
          "word_timings": {"type": "array"}
        }
      }
    }
  }
}
