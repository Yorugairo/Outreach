{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://outreach-program.internal/schemas/editorial-coverage.v1.json",
  "title": "Editorial Coverage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_shot_plan_hash",
    "duration_s",
    "slot_count",
    "cadence",
    "slots",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "editorial_coverage.v1"
    },
    "source_shot_plan_hash": {
      "$ref": "#/definitions/hash"
    },
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "slot_count": {
      "type": "integer",
      "minimum": 1
    },
    "cadence": {
      "type": "object"
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slot_id",
          "parent_shot_id",
          "narration_excerpt",
          "semantic_purpose",
          "preferred_visual_source",
          "fallback_visual_source",
          "duration_s",
          "motion_recipe",
          "micro_events",
          "uniqueness_signature"
        ],
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1
          },
          "parent_shot_id": {
            "type": "string",
            "minLength": 1
          },
          "narration_excerpt": {
            "type": "string",
            "minLength": 1
          },
          "semantic_purpose": {
            "enum": [
              "evidence",
              "setting",
              "person",
              "object",
              "transition",
              "humor",
              "explanation",
              "correction"
            ]
          },
          "visual_archetype": {
            "enum": [
              "archive_portrait",
              "chapter_card",
              "distance_map",
              "document_evidence",
              "entity_graph",
              "historical_martial_archive",
              "historical_travel_broll",
              "lofi_stick_figure_comic",
              "martial_arts_broll",
              "period_comic_block",
              "typography_explainer"
            ]
          },
          "stock_eligible": {
            "type": "boolean"
          },
          "preferred_visual_source": {
            "enum": [
              "archive",
              "stock_photo",
              "stock_vector",
              "original_illustration",
              "document",
              "map",
              "graph",
              "typography"
            ]
          },
          "fallback_visual_source": {
            "type": "string"
          },
          "search_concepts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "search_query": {
            "type": "string"
          },
          "required_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_term_groups": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "blocked_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 8
          },
          "motion_recipe": {
            "enum": [
              "parallax_push",
              "detail_punch",
              "masked_reveal",
              "evidence_highlight",
              "map_trace",
              "comic_pop",
              "split_compare",
              "type_build",
              "paper_transition"
            ]
          },
          "micro_events": {
            "type": "array",
            "minItems": 1
          },
          "uniqueness_signature": {
            "type": "string",
            "minLength": 1
          },
          "plate_kind": {
            "enum": [
              "generated_plate",
              "composed_plate"
            ],
            "description": "How this slot's plate is produced. Absent means generated_plate, preserving existing coverage. Composed slots are drawn by the renderer from structured values and never enter the prompt pack."
          }
        }
      }
    },
    "artifact_hash": {
      "$ref": "#/definitions/hash"
    },
    "timing_basis": {
      "enum": [
        "canonical",
        "estimated"
      ],
      "description": "'canonical' is compiled from word-level audio timings and is authoritative for render. 'estimated' is derived from word count / WPM before audio exists; it is valid for board layout, slot counting and prompt fan-out, and is refused by render-timing consumers."
    },
    "source_artifact_kind": {
      "enum": [
        "shot_plan",
        "director_proposal"
      ],
      "description": "What source_shot_plan_hash points at. Absent means shot_plan, preserving existing artifacts."
    }
  },
  "definitions": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
