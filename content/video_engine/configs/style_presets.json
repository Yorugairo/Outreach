      ],
      "palette": {
        "background": "#D6C6A8",
        "ink": "#30291F",
        "primary": "#8B3A2B",
        "secondary": "#607744"
      },
      "outline_width": 5,
      "camera_moves": [
        "hold",
        "parallax_push",
