{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://outreach-program.internal/schemas/editorial-motion-plan.v1.json",
  "title": "Editorial Motion Plan v1",
  "description": "Hash-bound shot instructions compiled from approved narration beats. Renderers resolve approved asset IDs locally and do not invent editorial motion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_storyboard_hash",
    "source_beat_plan_hash",
    "scene_bundle_hashes",
    "scene_flow_graph_hash",
    "asset_map_hash",
    "audio_manifest_hash",
    "pacing_recipe_hash",
    "duration_s",
    "shots",
    "provider_calls",
    "revision_only",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "editorial_motion_plan.v1"},
    "source_storyboard_hash": {"$ref": "#/definitions/hash"},
    "source_beat_plan_hash": {"$ref": "#/definitions/hash"},
    "scene_bundle_hashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/hash"}
    },
    "scene_flow_graph_hash": {"$ref": "#/definitions/hash"},
    "asset_map_hash": {"$ref": "#/definitions/hash"},
    "audio_manifest_hash": {"$ref": "#/definitions/hash"},
    "pacing_recipe_hash": {"$ref": "#/definitions/hash"},
    "duration_s": {"type": "number", "exclusiveMinimum": 0},
    "source_start_s": {"type": "number", "minimum": 0},
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/shot"}
    },
    "provider_calls": {"const": 0},
    "revision_only": {"const": true},
    "artifact_hash": {"$ref": "#/definitions/hash"}
  },
  "definitions": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "safe_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "focal_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "word_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_index", "end_index"],
      "properties": {
        "start_index": {"type": "integer", "minimum": 0},
        "end_index": {"type": "integer", "minimum": 0}
      }
    },
    "information_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "x", "y", "width", "height"],
      "properties": {
        "mode": {"enum": ["floating_label", "surface_ink", "none"]},
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "text_align": {"enum": ["left", "center", "right"]},
        "surface_asset_id": {"$ref": "#/definitions/safe_id"}
      }
    },
    "placement_region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "width", "height"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "layer_timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_at_s", "exit_duration_s", "exit_effect"],
      "properties": {
        "exit_at_s": {"type": "number", "minimum": 0},
        "exit_duration_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
        "exit_effect_duration_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
        "exit_effect": {"enum": ["none", "smoke_puff"]}
      }
    },
    "layer_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support_plane", "foot_anchor", "exclusion_zones"],
      "properties": {
        "support_plane": {"$ref": "#/definitions/placement_region"},
        "foot_anchor": {"$ref": "#/definitions/focal_point"},
        "exclusion_zones": {
          "type": "array",
          "items": {"$ref": "#/definitions/placement_region"}
        }
      }
    },
    "sound_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at_s", "duration_s", "volume", "sha256"],
      "properties": {
        "id": {"$ref": "#/definitions/safe_id"},
        "at_s": {"type": "number", "minimum": 0},
        "duration_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 5},
        "volume": {"type": "number", "minimum": 0, "maximum": 1},
        "sha256": {"$ref": "#/definitions/hash"}
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "role"],
      "properties": {
        "asset_id": {"$ref": "#/definitions/safe_id"},
        "role": {"enum": ["world", "depth", "character", "prop", "ambient", "diagram"]},
        "z_index": {"type": "integer"},
        "action": {"type": "string"},
        "mask_asset_id": {"$ref": "#/definitions/safe_id"},
        "timing": {"$ref": "#/definitions/layer_timing"},
        "placement": {"$ref": "#/definitions/layer_placement"},
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {"type": "number", "minimum": 0, "maximum": 1},
            "y": {"type": "number", "minimum": 0, "maximum": 1},
            "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "fit": {"enum": ["contain", "cover"]}
          }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "amount", "easing", "hold_in_s", "move_s", "hold_out_s"],
      "properties": {
        "kind": {"enum": ["locked", "push_settle", "pull_settle", "lateral_reveal", "foreground_parallax", "cut_on_motion"]},
        "amount": {"type": "number", "minimum": 0, "maximum": 0.06},
        "easing": {"enum": ["smoothstep", "ease_in_out", "linear"]},
        "hold_in_s": {"type": "number", "minimum": 0},
        "move_s": {"type": "number", "minimum": 0},
        "hold_out_s": {"type": "number", "minimum": 0},
        "direction": {"enum": ["left", "right", "up", "down", "toward_focal_point"]}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": {"enum": ["hard_cut", "match_cut", "paper_wipe", "chapter_fade", "crossfade"]},
        "reason": {"type": "string"},
        "motif_id": {"$ref": "#/definitions/safe_id"},
        "duration_s": {"type": "number", "minimum": 0, "maximum": 1.5},
        "time_or_place_change": {"type": "boolean"}
      }
    },
    "provider_motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement", "fallback"],
      "properties": {
        "requirement": {"enum": ["none", "preferred", "required"]},
        "fallback": {"enum": ["local_layer_motion", "locked_hold", "omit_shot"]},
        "candidate_asset_id": {"$ref": "#/definitions/safe_id"}
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "parent_beat_ids",
        "parent_scene_bundle_id",
        "start_s",
        "duration_s",
        "word_range",
        "narration_excerpt",
        "purpose",
        "shot_scale",
        "focal_point",
        "layers",
        "subject_action",
        "ambient_actions",
        "information_reveal",
        "camera",
        "transition_in",
        "transition_out",
        "audio_bridge",
        "provider_motion",
        "overlay_ids",
        "uniqueness_signature"
      ],
      "properties": {
        "shot_id": {"$ref": "#/definitions/safe_id"},
        "parent_beat_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/safe_id"}},
        "parent_scene_bundle_id": {"$ref": "#/definitions/safe_id"},
        "start_s": {"type": "number", "minimum": 0},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "word_range": {"$ref": "#/definitions/word_range"},
        "narration_excerpt": {"type": "string", "minLength": 1},
        "visual_intent": {"enum": ["academic", "martial", "scenic", "journey", "evidence", "explanation", "humor", "transition"]},
        "required_visual_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "subject"],
            "properties": {
              "kind": {"enum": ["map_cut_in", "list_item_popout", "object_cutaway", "character_action", "scenic_cutaway"]},
              "subject": {"type": "string", "minLength": 1}
            }
          }
        },
        "purpose": {"enum": ["hook", "establish", "reveal", "explain", "detail", "reaction", "payoff", "chapter_reset"]},
        "shot_scale": {"enum": ["wide", "medium", "medium_detail", "close", "insert"]},
        "focal_point": {"$ref": "#/definitions/focal_point"},
        "layers": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/layer"}},
        "subject_action": {"type": "string"},
        "ambient_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "sound_effects": {"type": "array", "items": {"$ref": "#/definitions/sound_effect"}},
        "information_reveal": {"type": "string"},
        "information_surface": {"$ref": "#/definitions/information_surface"},
        "camera": {"$ref": "#/definitions/camera"},
        "transition_in": {"$ref": "#/definitions/transition"},
        "transition_out": {"$ref": "#/definitions/transition"},
        "audio_bridge": {"enum": ["continuous_narration", "none", "j_cut", "l_cut"]},
        "provider_motion": {"$ref": "#/definitions/provider_motion"},
        "overlay_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/safe_id"}},
        "uniqueness_signature": {"type": "string", "minLength": 1}
      }
    }
  }
}
