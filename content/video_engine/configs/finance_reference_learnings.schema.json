{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "finance_reference_learnings.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "references", "synthesis_rules", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "finance_reference_learnings.v1"},
    "references": {"type": "array", "minItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["reference_id", "url", "observed_patterns", "adopt", "do_not_copy"], "properties": {"reference_id": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "observed_patterns": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "adopt": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "do_not_copy": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
    "synthesis_rules": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
