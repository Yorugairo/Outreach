{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://outreach-program.internal/schemas/model_scene.v1.json",
  "title": "Authored model scene v1",
  "description": "Binds exact immutable model revisions to an authored rational scene clock, optional source mappings, contacts and events.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "duration_frames", "fps", "time_origin", "bindings", "participants", "source_time_mappings", "contacts", "events", "attachments"],
  "properties": {
    "schema_version": {"const": "model_scene.v1"},
    "scene_id": {"$ref": "#/definitions/safe_id"},
    "duration_frames": {"type": "integer", "minimum": 1},
    "fps": {"$ref": "#/definitions/rational_positive"},
    "time_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_frame", "scene_time_seconds"],
      "properties": {
        "scene_frame": {"const": 0},
        "scene_time_seconds": {"$ref": "#/definitions/rational_nonnegative"}
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["binding_id", "asset_id", "revision_id", "descriptor_path", "descriptor_sha256"],
        "properties": {
          "binding_id": {"$ref": "#/definitions/safe_id"},
          "asset_id": {"$ref": "#/definitions/safe_id"},
          "revision_id": {"$ref": "#/definitions/safe_id"},
          "descriptor_path": {"$ref": "#/definitions/relative_path"},
          "descriptor_sha256": {"$ref": "#/definitions/sha256"}
        }
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["participant_id", "binding_id", "semantic_joint_requirements", "face_control_requirements"],
        "properties": {
          "participant_id": {"$ref": "#/definitions/safe_id"},
          "binding_id": {"$ref": "#/definitions/safe_id"},
          "semantic_joint_requirements": {"$ref": "#/definitions/string_set"},
          "face_control_requirements": {"$ref": "#/definitions/string_set"}
        }
      }
    },
    "source_time_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "path", "sha256", "scene_frame_start", "scene_frame_end", "source_time_start_seconds", "source_seconds_per_scene_frame"],
        "properties": {
          "source_id": {"$ref": "#/definitions/safe_id"},
          "path": {"$ref": "#/definitions/relative_path"},
          "sha256": {"$ref": "#/definitions/sha256"},
          "scene_frame_start": {"type": "integer", "minimum": 0},
          "scene_frame_end": {"type": "integer", "minimum": 1},
          "source_time_start_seconds": {"$ref": "#/definitions/rational_nonnegative"},
          "source_seconds_per_scene_frame": {"$ref": "#/definitions/rational_positive"}
        }
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contact_id", "actor_binding_id", "semantic_effector", "target_binding_id", "start_frame", "end_frame"],
        "properties": {
          "contact_id": {"$ref": "#/definitions/safe_id"},
          "actor_binding_id": {"$ref": "#/definitions/safe_id"},
          "semantic_effector": {"type": "string", "minLength": 1},
          "target_binding_id": {"$ref": "#/definitions/safe_id"},
          "target_surface_id": {"$ref": "#/definitions/safe_id"},
          "target_semantic_joint": {"type": "string", "minLength": 1},
          "start_frame": {"type": "integer", "minimum": 0},
          "end_frame": {"type": "integer", "minimum": 1}
        },
        "oneOf": [
          {"required": ["target_surface_id"], "not": {"required": ["target_semantic_joint"]}},
          {"required": ["target_semantic_joint"], "not": {"required": ["target_surface_id"]}}
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "event_type", "frame"],
        "properties": {
          "event_id": {"$ref": "#/definitions/safe_id"},
          "event_type": {"type": "string", "minLength": 1},
          "frame": {"type": "integer", "minimum": 0},
          "binding_id": {"$ref": "#/definitions/safe_id"}
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attachment_id", "parent_binding_id", "parent_socket", "child_binding_id", "child_socket"],
        "properties": {
          "attachment_id": {"$ref": "#/definitions/safe_id"},
          "parent_binding_id": {"$ref": "#/definitions/safe_id"},
          "parent_socket": {"type": "string", "minLength": 1},
          "child_binding_id": {"$ref": "#/definitions/safe_id"},
          "child_socket": {"type": "string", "minLength": 1}
        }
      }
    },
    "camera": {"$ref": "#/definitions/camera"},
    "lights": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/definitions/light"}
    },
    "environment_collision_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["binding_id", "surface_id", "collision_mode"],
        "properties": {
          "binding_id": {"$ref": "#/definitions/safe_id"},
          "surface_id": {"$ref": "#/definitions/safe_id"},
          "collision_mode": {"enum": ["solid", "trigger", "disabled"]},
          "friction": {"type": "number", "minimum": 0.0, "maximum": 2.0},
          "restitution": {"type": "number", "minimum": 0.0, "maximum": 1.0}
        }
      }
    },
    "motion_channels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id", "binding_id", "target_kind", "semantic_target", "value_unit", "interpolation", "keyframes"],
        "properties": {
          "channel_id": {"$ref": "#/definitions/safe_id"},
          "binding_id": {"$ref": "#/definitions/safe_id"},
          "target_kind": {"enum": ["semantic_joint", "face_control", "articulation", "object_transform"]},
          "semantic_target": {"type": "string", "minLength": 1},
          "value_unit": {"enum": ["normalized", "m", "radians", "degrees", "vector3_m", "quaternion"]},
          "interpolation": {"enum": ["step", "linear", "cubic"]},
          "keyframes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["frame", "value"],
              "properties": {
                "frame": {"type": "integer", "minimum": 0},
                "value": {"$ref": "#/definitions/motion_value"}
              }
            }
          }
        }
      }
    },
    "render_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_id", "resolution_px", "samples", "passes"],
      "properties": {
        "engine_id": {"enum": ["blender_cycles", "blender_eevee", "other"]},
        "resolution_px": {"$ref": "#/definitions/resolution_px"},
        "samples": {"type": "integer", "minimum": 1, "maximum": 4096},
        "passes": {"type": "array", "uniqueItems": true, "items": {"enum": ["beauty", "depth", "normal", "object_mask", "material_mask"]}},
        "color_space": {"type": "string", "minLength": 1}
      }
    },
    "art_treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style_id", "shading_model"],
      "properties": {
        "style_id": {"$ref": "#/definitions/safe_id"},
        "shading_model": {"enum": ["stylized_realism", "toon", "anime", "low_fidelity_2d", "hybrid"]},
        "outline_width_px": {"type": "number", "minimum": 0.0, "maximum": 32.0},
        "outline_color_rgba": {"$ref": "#/definitions/color_rgba"},
        "palette_id": {"$ref": "#/definitions/safe_id"}
      }
    }
  },
  "definitions": {
    "safe_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "relative_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$)).+$"},
    "string_set": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rational_positive": {
      "type": "object", "additionalProperties": false, "required": ["numerator", "denominator"],
      "properties": {"numerator": {"type": "integer", "minimum": 1}, "denominator": {"type": "integer", "minimum": 1}}
    },
    "rational_nonnegative": {
      "type": "object", "additionalProperties": false, "required": ["numerator", "denominator"],
      "properties": {"numerator": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 1}}
    },
    "vector3_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -10000.0, "maximum": 10000.0}},
    "vector3_unit": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -1.0, "maximum": 1.0}},
    "vector3_color": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0.0, "maximum": 1.0}},
    "color_rgba": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0.0, "maximum": 1.0}},
    "resolution_px": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1, "maximum": 8192}},
    "motion_value": {
      "oneOf": [
        {"type": "number", "minimum": -1000000.0, "maximum": 1000000.0},
        {"$ref": "#/definitions/vector3_m"},
        {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": -1.0, "maximum": 1.0}}
      ]
    },
    "camera": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["projection", "position_m", "target_m", "clip_planes_m", "focal_length_mm"],
          "properties": {
            "projection": {"const": "perspective"}, "position_m": {"$ref": "#/definitions/vector3_m"}, "target_m": {"$ref": "#/definitions/vector3_m"},
            "clip_planes_m": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 100000.0}},
            "focal_length_mm": {"type": "number", "minimum": 1.0, "maximum": 300.0}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["projection", "position_m", "target_m", "clip_planes_m", "orthographic_scale_m"],
          "properties": {
            "projection": {"const": "orthographic"}, "position_m": {"$ref": "#/definitions/vector3_m"}, "target_m": {"$ref": "#/definitions/vector3_m"},
            "clip_planes_m": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 100000.0}},
            "orthographic_scale_m": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 10000.0}
          }
        }
      ]
    },
    "light": {
      "type": "object", "additionalProperties": false,
      "required": ["light_id", "light_type", "energy_w", "color_rgb"],
      "properties": {
        "light_id": {"$ref": "#/definitions/safe_id"},
        "light_type": {"enum": ["point", "spot", "area", "sun"]},
        "energy_w": {"type": "number", "minimum": 0.0, "maximum": 100000000.0},
        "color_rgb": {"$ref": "#/definitions/vector3_color"},
        "position_m": {"$ref": "#/definitions/vector3_m"},
        "direction_xyz": {"$ref": "#/definitions/vector3_unit"},
        "size_m": {"type": "number", "exclusiveMinimum": 0.0, "maximum": 10000.0}
      }
    }
  }
}
