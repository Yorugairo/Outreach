{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editorial_visual_revision.v1",
  "title": "Immutable Editorial Visual Revision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision_id",
    "revision_only",
    "base_snapshot_hash",
    "base_artifact_hashes",
    "operator",
    "operations"
  ],
  "properties": {
    "schema_version": {"const": "editorial_visual_revision.v1"},
    "revision_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "revision_only": {"const": true},
    "base_snapshot_hash": {"$ref": "#/$defs/sha256"},
    "base_artifact_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator_id", "created_at"],
      "properties": {
        "operator_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "created_at": {"type": "string", "format": "date-time"}
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/operation"}
    },
    "note": {"type": ["string", "null"], "maxLength": 2000},
    "artifact_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id"],
      "properties": {
        "scene_id": {"type": "string", "minLength": 1},
        "layer_id": {"type": ["string", "null"]}
      }
    },
    "operation": {
      "oneOf": [
        {"$ref": "#/$defs/selectAsset"},
        {"$ref": "#/$defs/setTransform"},
        {"$ref": "#/$defs/setCrop"},
        {"$ref": "#/$defs/setMotionRecipe"},
        {"$ref": "#/$defs/offsetVisualEvent"},
        {"$ref": "#/$defs/setCaptionSafeBand"},
        {"$ref": "#/$defs/setTeacherStamp"},
        {"$ref": "#/$defs/addReviewNote"},
        {"$ref": "#/$defs/setShotStatus"}
      ]
    },
    "selectAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "asset_id"],
      "properties": {
        "op": {"const": "select_asset"},
        "target": {"$ref": "#/$defs/target"},
        "asset_id": {"type": "string", "minLength": 1}
      }
    },
    "setTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "x", "y", "scale", "opacity", "z"],
      "properties": {
        "op": {"const": "set_transform"},
        "target": {"$ref": "#/$defs/target"},
        "x": {"type": "number", "minimum": -2, "maximum": 2},
        "y": {"type": "number", "minimum": -2, "maximum": 2},
        "scale": {"type": "number", "minimum": 0.1, "maximum": 4},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "z": {"type": "integer", "minimum": -100, "maximum": 100}
      }
    },
    "setCrop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "left", "top", "width", "height"],
      "properties": {
        "op": {"const": "set_crop"},
        "target": {"$ref": "#/$defs/target"},
        "left": {"type": "number", "minimum": 0, "maximum": 1},
        "top": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "setMotionRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "recipe_id"],
      "properties": {
        "op": {"const": "set_motion_recipe"},
        "target": {"$ref": "#/$defs/target"},
        "recipe_id": {"enum": ["hold", "marker_reveal", "slow_push", "evidence_slide", "whiteboard_trace"]}
      }
    },
    "offsetVisualEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "event_id", "offset_s"],
      "properties": {
        "op": {"const": "offset_visual_event"},
        "target": {"$ref": "#/$defs/target"},
        "event_id": {"type": "string", "minLength": 1},
        "offset_s": {"type": "number", "minimum": -3, "maximum": 3}
      }
    },
    "setCaptionSafeBand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "band"],
      "properties": {
        "op": {"const": "set_caption_safe_band"},
        "target": {"$ref": "#/$defs/target"},
        "band": {"enum": ["lower", "upper", "off"]}
      }
    },
    "setTeacherStamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "variant"],
      "properties": {
        "op": {"const": "set_teacher_stamp"},
        "target": {"$ref": "#/$defs/target"},
        "variant": {"enum": ["approved_forward-pointing", "hidden"]}
      }
    },
    "addReviewNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "note"],
      "properties": {
        "op": {"const": "add_review_note"},
        "target": {"$ref": "#/$defs/target"},
        "note": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "setShotStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "status"],
      "properties": {
        "op": {"const": "set_shot_status"},
        "target": {"$ref": "#/$defs/target"},
        "status": {"enum": ["unreviewed", "revision_required", "ready_for_review"]}
      }
    }
  }
}
