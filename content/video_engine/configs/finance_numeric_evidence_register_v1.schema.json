{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "finance_numeric_evidence_register.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "claim_ledger_hash", "verified_report", "items", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "finance_numeric_evidence_register.v1"},
    "episode_id": {"type": "string", "minLength": 1},
    "claim_ledger_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verified_report": {
      "type": "object", "additionalProperties": false,
      "required": ["report_id", "title", "location"],
      "properties": {"report_id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "location": {"type": "string", "minLength": 1}}
    },
    "items": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["surface_id", "claim_id", "display_value", "unit", "as_of", "report_locator", "format", "qualifier", "permitted_surface_types"],
        "properties": {
          "surface_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "claim_id": {"type": "string", "minLength": 1},
          "display_value": {"type": ["number", "string"]},
          "unit": {"type": "string", "minLength": 1},
          "as_of": {"type": "string", "minLength": 4},
          "report_locator": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1},
          "qualifier": {"type": "string", "minLength": 3},
          "permitted_surface_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["statistic", "chart", "comparison_bar", "report_page", "timeline", "flow", "balance_sheet", "weight_diagram"]}},
          "market_data_binding": {
            "type": ["object", "null"], "additionalProperties": false,
            "required": ["packet_hash", "instrument_id", "metric", "rounding_decimals"],
            "properties": {
              "packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "instrument_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "metric": {"const": "return_pct"},
              "rounding_decimals": {"type": "integer", "minimum": 0, "maximum": 6}
            }
          }
        }
      }
    },
    "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
