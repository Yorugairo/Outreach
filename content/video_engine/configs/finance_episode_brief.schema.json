{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "finance_episode_brief.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "format", "working_title", "audience_tension", "lived_contradiction", "popular_explanation", "missing_mechanism", "thesis_state", "thesis", "actors", "distribution_question", "countercase", "failure_conditions", "plain_language_translation", "visual_metaphor", "packages", "embedded_short", "research_blockers", "human_gates", "state", "render_eligible", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "finance_episode_brief.v1"},
    "episode_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "format": {"enum": ["economic_anatomy", "one_level_deeper", "current_mechanism"]},
    "working_title": {"type": "string", "minLength": 8},
    "audience_tension": {"type": "string", "minLength": 20},
    "lived_contradiction": {"type": "string", "minLength": 20},
    "popular_explanation": {"type": "string", "minLength": 20},
    "missing_mechanism": {"type": "string", "minLength": 20},
    "thesis_state": {"enum": ["research_question", "operator_approved"]},
    "thesis": {"type": "string", "minLength": 20},
    "actors": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "distribution_question": {"type": "string", "minLength": 20},
    "countercase": {"type": "string", "minLength": 20},
    "failure_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
    "plain_language_translation": {"type": "string", "minLength": 20},
    "visual_metaphor": {"type": "string", "minLength": 20},
    "packages": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "family", "title", "thumbnail_text", "promise_key"],
        "properties": {
          "id": {"type": "string"},
          "family": {"enum": ["contradiction", "identity", "mechanism"]},
          "title": {"type": "string", "minLength": 8},
          "thumbnail_text": {"type": "string", "minLength": 2, "maxLength": 28},
          "promise_key": {"type": "string", "minLength": 3}
        }
      }
    },
    "embedded_short": {
      "type": "object", "additionalProperties": false,
      "required": ["working_title", "capsule_state", "target_seconds", "recorded_in_long_master"],
      "properties": {
        "working_title": {"type": "string", "minLength": 5},
        "capsule_state": {"enum": ["planned", "word_timed"]},
        "target_seconds": {"type": "integer", "minimum": 40, "maximum": 60},
        "recorded_in_long_master": {"const": true}
      }
    },
    "research_blockers": {"type": "array", "items": {"type": "string"}},
    "human_gates": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}},
    "state": {"enum": ["draft", "research_locked", "operator_approved"]},
    "render_eligible": {"type": "boolean"},
    "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
