{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://outreach-program.internal/schemas/scene-flow-graph.v1.json",
  "title": "Scene Flow Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "series_id", "planning_scope", "communication_grammar_hash", "asset_map_hash", "policy", "scenes", "edges", "summary", "render_eligible", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "scene_flow_graph.v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "series_id": {"type": "string", "minLength": 1},
    "planning_scope": {"const": "foundation_scene_families"},
    "communication_grammar_hash": {"$ref": "#/definitions/hash"},
    "asset_map_hash": {"$ref": "#/definitions/hash"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_layout_reused", "one_or_two_motifs_per_chapter", "question_briefs_are_not_claims"],
      "properties": {
        "catalog_layout_reused": {"const": true},
        "one_or_two_motifs_per_chapter": {"const": true},
        "question_briefs_are_not_claims": {"const": true}
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "episode_id", "order", "title", "purpose", "research_state", "style_pack_id", "target_duration_s", "narration_beats_target", "world_asset_id", "character_asset_ids", "prop_asset_ids", "fact_surface_ids", "ambient_loop_ids", "entry_motif_id", "exit_motif_id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "episode_id": {"type": "string", "pattern": "^episode-[1-3]$"},
          "order": {"type": "integer", "minimum": 1},
          "title": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "research_state": {"enum": ["approved", "question_only"]},
          "style_pack_id": {"type": "string", "minLength": 1},
          "target_duration_s": {"type": "number", "minimum": 20, "maximum": 30},
          "narration_beats_target": {"type": "integer", "minimum": 2, "maximum": 4},
          "world_asset_id": {"type": "string", "minLength": 1},
          "character_asset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "prop_asset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "fact_surface_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "ambient_loop_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "entry_motif_id": {"type": "string", "minLength": 1},
          "exit_motif_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "connector_type", "motif_id", "cut_point", "rationale"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "connector_type": {"enum": ["direction", "shape", "material", "object", "color", "character", "structural_reset"]},
          "motif_id": {"type": "string", "minLength": 1},
          "cut_point": {"enum": ["anticipation", "contact", "recoil", "result", "not_action"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_count", "edge_count", "episode_counts"],
      "properties": {
        "scene_count": {"type": "integer", "minimum": 2},
        "edge_count": {"type": "integer", "minimum": 1},
        "episode_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}
      }
    },
    "render_eligible": {"const": false},
    "artifact_hash": {"$ref": "#/definitions/hash"}
  },
  "definitions": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
