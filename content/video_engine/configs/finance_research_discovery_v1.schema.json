{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "finance_research_discovery.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "query", "retrieved_at", "synthesis_markdown", "sources", "discovery_only", "requires_primary_verification", "render_eligible", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "finance_research_discovery.v1"},
    "episode_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "query": {"type": "string", "minLength": 10},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "synthesis_markdown": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "domain", "source_class", "verification_state"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "domain": {"type": "string", "minLength": 1},
          "source_class": {"enum": ["primary_candidate", "secondary_context", "unknown"]},
          "verification_state": {"const": "not_opened"}
        }
      }
    },
    "discovery_only": {"const": true},
    "requires_primary_verification": {"const": true},
    "render_eligible": {"const": false},
    "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
