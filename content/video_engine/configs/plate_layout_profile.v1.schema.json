{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outreach-program.internal/schemas/plate-layout-profile.v1.json",
  "title": "Plate Layout Profile v1",
  "description": "Hash-bound normalized geometry for a reviewed world plate and its evidence/caption grammar.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "title",
    "world_asset_id",
    "world_asset_sha256",
    "status",
    "focal_regions",
    "protected_regions",
    "negative_space_regions",
    "evidence_slots",
    "caption_safe_regions",
    "annotation_anchors",
    "source_marker",
    "limits",
    "fallbacks",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "plate_layout_profile.v1"},
    "profile_id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "world_asset_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
    "world_asset_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "status": {"enum": ["reviewed", "experimental", "manual_only"]},
    "focal_regions": {"type": "array", "items": {"$ref": "#/$defs/region"}},
    "protected_regions": {"type": "array", "items": {"$ref": "#/$defs/region"}},
    "negative_space_regions": {"type": "array", "items": {"$ref": "#/$defs/region"}},
    "evidence_slots": {
      "type": "array",
      "items": {"$ref": "#/$defs/slot"}
    },
    "caption_safe_regions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/region"}
    },
    "annotation_anchors": {
      "type": "array",
      "items": {"$ref": "#/$defs/anchor"}
    },
    "source_marker": {"$ref": "#/$defs/sourceMarker"},
    "limits": {"$ref": "#/$defs/limits"},
    "fallbacks": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["manual_only", "unmatched", "next_safe_slot"]}
    },
    "artifact_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "label", "rect"],
      "properties": {
        "region_id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 200},
        "rect": {"$ref": "#/$defs/rect"}
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "order",
        "label",
        "rect",
        "semantic_roles",
        "alignment",
        "max_width",
        "max_height",
        "safe",
        "annotation_anchor_id",
        "source_marker"
      ],
      "properties": {
        "slot_id": {"$ref": "#/$defs/id"},
        "order": {"type": "integer", "minimum": 1},
        "label": {"type": "string", "minLength": 1, "maxLength": 200},
        "rect": {"$ref": "#/$defs/rect"},
        "semantic_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["mechanism", "comparison", "metric", "timeline", "source_quote", "evidence"]}
        },
        "alignment": {"enum": ["left", "center", "right"]},
        "max_width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "safe": {"type": "boolean"},
        "annotation_anchor_id": {"$ref": "#/$defs/id"},
        "source_marker": {"$ref": "#/$defs/slotSourceMarker"}
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_id", "point", "max_leader_length"],
      "properties": {
        "anchor_id": {"$ref": "#/$defs/id"},
        "point": {"$ref": "#/$defs/point"},
        "max_leader_length": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "slotSourceMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placement", "inset"],
      "properties": {
        "placement": {"const": "inside_slot"},
        "inset": {"type": "number", "minimum": 0, "maximum": 0.25}
      }
    },
    "sourceMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placement", "max_width", "max_height"],
      "properties": {
        "placement": {"enum": ["inside_slot", "caption_safe_region"]},
        "max_width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_world_plates", "max_evidence_images", "max_hands", "max_annotations", "max_source_markers"],
      "properties": {
        "max_world_plates": {"const": 1},
        "max_evidence_images": {"const": 1},
        "max_hands": {"const": 1},
        "max_annotations": {"const": 1},
        "max_source_markers": {"const": 1}
      }
    }
  }
}
