    "carry_forward": [
      "composition",
      "motion_economics",
      "editing",
      "visual_hierarchy",
      "sound_hierarchy"
    ],
    "brand_overrides": [
      "Replace source character construction with original angular Combat History cutout characters.",
      "Replace source typography and titles with a literary folio, Inter narration type, and Roboto Mono evidence rails.",
      "Use BJJ-specific maps, documents, clothing, locations, and relationship data.",
      "Make archives and citations a recurring proof mode rather than occasional decoration.",
      "Use a dry margin narrator and recurring evidence-stamp gag as the comedic voice."
    ],
    "differentiation": [
      "Combat History characters use long angular torsos, rectangular hands, dot eyes, and asymmetric gi or period clothing panels.",
      "Green evidence rails, red correction stamps, and numbered folios form an original recurring identity.",
      "Every factual sequence resolves to a local archive, document, map datum, or qualified citation.",
      "Map lines transform into chapter rules and evidence underlines as a channel-specific transition motif."
    ]
  },
  "palette": {
    "paper": "#E9D7B0",
    "ink": "#17191B",
    "background": "#101419",
    "surface": "#252C32",
    "rust": "#B84E38",
    "indigo": "#31577A",
    "jade": "#267B68",
    "ochre": "#D69A35",
    "muted": "#918877",
    "sky": "#8FAFC1",
    "field": "#7E8D58",
    "highlighter": "#F0CD55"
  },
  "typography": {
    "family": "Inter",
    "caption_font": "Inter (local OFL)",
    "measurement_font": "Roboto Mono (local OFL)",
    "caption_source": "checked-in local OFL font assets",
    "measurement_source": "checked-in local OFL font assets",
    "weight": "semibold",
    "case": "sentence",
    "tracking": 0.01,
    "safe_chars": 42
