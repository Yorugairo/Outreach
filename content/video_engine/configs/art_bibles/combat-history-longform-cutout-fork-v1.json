  "style_atoms": [
    {
      "id": "combat-history-cutout-cast",
      "kind": "cast",
      "description": "Original angular cutout characters use thick ink outlines, flat clothing panels, restrained facial features, and prop-led acting.",
      "tokens": {
        "outline_px": 7,
        "torso": "angular",
        "hands": "rectangular",
        "eyes": "dot",
        "pose_changes": "stepped"
      },
      "applies_to": ["artifact_cold_open", "illustrated_reconstruction", "chapter_cta"]
    },
    {
      "id": "layered-history-tableau",
      "kind": "illustration",
      "description": "Foreground props, cutout actors, middle-ground architecture, and a quiet painted field create economical historical depth.",
      "tokens": {
        "depth_planes": 3,
        "foreground": "prop",
        "midground": "cast",
        "background": "place",
        "label": "ILLUSTRATION / RECONSTRUCTION"
      },
      "applies_to": ["illustrated_reconstruction", "artifact_cold_open"]
    },
    {
      "id": "map-to-character-transition",
      "kind": "transition",
      "description": "A route, border, or place marker enlarges into the next scene's road, wall, prop, or chapter rule.",
      "tokens": {
        "source": "map_shape",
        "destination": "scene_anchor",
        "continuity": "shape_and_direction"
      },
      "applies_to": ["migration_map_timeline", "illustrated_reconstruction"]
    },
    {
      "id": "dry-reaction-insert",
      "kind": "illustration",
      "description": "A short original reaction pose or margin note punctures a simplification without carrying factual proof.",
      "tokens": {
        "maximum_s": 3.5,
        "background": "paper",
        "accent": "rust",
        "evidence_role": false
      },
      "applies_to": ["concept_mechanics_cutaway", "chapter_cta"]
    },
    {
      "id": "archive-proof-window",
      "kind": "archive",
      "description": "A rights-reviewed archive receives restrained parallax, an evidence stamp, and an exact source rail.",
      "tokens": {
        "parallax_px": 16,
        "matte": "surface",
        "stamp": "EVIDENCE",
        "citation": "jade"
      },
      "applies_to": ["archival_portrait", "artifact_cold_open"]
    },
    {
      "id": "document-proof-window",
      "kind": "document",
      "description": "The cited passage is highlighted inside a document field while qualification and locator remain visible.",
      "tokens": {
        "paper": "paper",
        "highlight": "highlighter",
        "qualification": "rust",
        "citation": "jade"
      },
      "applies_to": ["document_quote_closeup"]
    },
    {
      "id": "typed-relationship-only",
      "kind": "diagram",
      "description": "Relationship cards require named historical entities, a sourced verb, and an explicit direction or symmetric edge.",
      "tokens": {
        "named_entities_required": 2,
        "edge_label_required": true,
        "keyword_fallback": false,
        "uncertainty_style": "dashed"
      },
      "applies_to": ["lineage_graph"]
    },
    {
      "id": "combat-history-folio",
      "kind": "type",
      "description": "Numbered folios, green evidence rails, and red correction stamps bind comedy, illustration, maps, and archives into one authored volume.",
      "tokens": {
        "folio": true,
        "evidence_rail": "jade",
        "correction_stamp": "rust",
        "safe_margin": 0.08
      },
      "applies_to": ["artifact_cold_open", "archival_portrait", "illustrated_reconstruction", "document_quote_closeup", "migration_map_timeline", "lineage_graph", "concept_mechanics_cutaway", "chapter_cta"]
    }
