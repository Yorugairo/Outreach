{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://outreach-program.internal/schemas/art-bible.v2.json",
  "title": "History Documentary Art Bible v2",
  "description": "Internal style atoms plus approved asset categories for History V4. Renderer inputs never contain study provenance or creator imitation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "render_policy",
    "palette",
    "typography",
    "style_atoms",
    "composition",
    "motion",
    "approved_asset_categories"
  ],
  "properties": {
    "schema_version": { "const": "art_bible.v2", "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "channel": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "render_policy": { "$ref": "#/definitions/renderPolicy" },
    "palette": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "typography": { "$ref": "#/definitions/typography" },
    "style_atoms": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/definitions/styleAtom" }
    },
    "composition": { "$ref": "#/definitions/composition" },
    "motion": { "$ref": "#/definitions/motion" },
    "approved_asset_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": [
        "archival_photo",
        "original_illustration",
        "document_scan",
        "map",
        "diagram",
        "texture",
        "typography"
      ] }
    },
    "profile_derivation": {
      "$ref": "#/definitions/profileDerivation"
    },
    "signature": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "artifact_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "definitions": {
    "renderPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_domain", "allow_external_assets", "allow_creator_imitation"],
      "properties": {
        "input_domain": { "type": "string", "const": "internal_style_atoms_and_approved_asset_ids" },
        "allow_external_assets": { "type": "boolean", "const": false },
        "allow_creator_imitation": { "type": "boolean", "const": false },
        "approved_asset_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "caption_font", "measurement_font", "weight", "case", "tracking", "safe_chars"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "caption_font": { "type": "string", "minLength": 1 },
        "measurement_font": { "type": "string", "minLength": 1 },
        "caption_source": { "type": "string", "minLength": 1 },
        "measurement_source": { "type": "string", "minLength": 1 },
        "weight": { "type": "string", "enum": ["regular", "medium", "semibold", "bold"] },
        "case": { "type": "string", "enum": ["sentence", "title", "upper"] },
        "tracking": { "type": "number", "minimum": -0.2, "maximum": 0.5 },
        "safe_chars": { "type": "integer", "minimum": 1 }
      }
    },
    "profileDerivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "base_profile_id",
        "base_profile_hash",
        "carry_forward",
        "brand_overrides",
        "differentiation"
      ],
      "properties": {
        "contract": {
          "const": "production_profile_fork.v1"
        },
        "base_profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "base_profile_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "carry_forward": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "composition",
              "motion_economics",
              "editing",
              "visual_hierarchy",
              "sound_hierarchy"
            ]
          }
        },
        "brand_overrides": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "differentiation": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "styleAtom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "tokens"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "type": "string", "enum": ["field", "cast", "contact", "diagram", "type", "transition", "texture", "accent", "archive", "document", "illustration"] },
        "description": { "type": "string", "minLength": 1 },
        "tokens": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": { "^[a-z][a-z0-9_]*$": { "type": ["string", "number", "boolean", "array"] } }
        },
        "applies_to": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe_margin", "anchor_grid", "functions"],
      "properties": {
        "safe_margin": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.25 },
        "anchor_grid": { "type": "string", "enum": ["rule_of_thirds", "four_anchor", "centerline", "document_grid"] },
        "max_repeated_framing": { "type": "integer", "minimum": 1, "maximum": 6 },
        "functions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/functionRule" }
        }
      }
    },
    "functionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framing", "atom_ids"],
      "properties": {
        "framing": { "type": "string", "minLength": 1 },
        "atom_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "emphasis": { "type": "string", "minLength": 1 },
        "asset_category": { "type": "string", "minLength": 1 }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_order", "easing", "transition_motifs"],
      "properties": {
        "phase_order": { "type": "array", "minItems": 2, "items": { "type": "string", "enum": ["anticipation", "reveal", "action", "contact", "recovery", "hold"] } },
        "easing": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
        "transition_motifs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
