{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outreach-program.internal/schemas/full-episode-evidence-coverage.v1.json",
  "title": "Full Episode Evidence Coverage v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "compiler_version", "episode_id", "approval_boundary", "source_hashes", "summary", "scenes", "world_plate_library", "approved_source_surfaces", "resolution_segments", "cadence_turns", "cues", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "full_episode_evidence_coverage.v1"},
    "compiler_version": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "approval_boundary": {"type": "object", "additionalProperties": false, "required": ["evidence", "world_plates", "next_gate"], "properties": {"evidence": {"type": "string"}, "world_plates": {"type": "string"}, "next_gate": {"type": "string"}}},
    "source_hashes": {"type": "object", "minProperties": 8, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["duration_s", "word_count", "cue_count", "scene_count", "evidence_asset_count", "production_ready_source_surface_count", "context_crop_count", "composition_world_plate_count", "base_resolution_segment_count", "over_twenty_second_hold_count", "cadence_turn_count", "new_world_art_gap_count", "evidence_status_counts"], "properties": {"duration_s": {"type": "number", "exclusiveMinimum": 0}, "word_count": {"type": "integer", "minimum": 1}, "cue_count": {"type": "integer", "minimum": 1}, "scene_count": {"type": "integer", "const": 11}, "evidence_asset_count": {"type": "integer", "const": 95}, "production_ready_source_surface_count": {"type": "integer", "const": 86}, "context_crop_count": {"type": "integer", "const": 9}, "composition_world_plate_count": {"type": "integer", "const": 76}, "base_resolution_segment_count": {"type": "integer", "minimum": 1}, "over_twenty_second_hold_count": {"type": "integer", "minimum": 0}, "cadence_turn_count": {"type": "integer", "minimum": 0}, "new_world_art_gap_count": {"type": "integer", "minimum": 0}, "evidence_status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}},
    "scenes": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"$ref": "#/$defs/scene"}},
    "world_plate_library": {"type": "array", "minItems": 76, "items": {"$ref": "#/$defs/world"}},
    "approved_source_surfaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "resolution_segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}},
    "cadence_turns": {"type": "array", "items": {"$ref": "#/$defs/turn"}},
    "cues": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cue"}},
    "artifact_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "world": {"type": "object", "required": ["asset_id", "kind", "path", "sha256", "source", "claim_refs", "semantic_tags", "composition_approval", "range_s"], "properties": {"asset_id": {"type": "string"}, "kind": {"type": "string"}, "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}, "source": {"enum": ["asset_map", "sentence_native_manifest"]}, "claim_refs": {"type": "array", "items": {"type": "string"}}, "semantic_tags": {"type": "array", "items": {"type": "string"}}, "composition_approval": {"type": "string"}, "range_s": {"type": ["object", "null"]}}},
    "source": {"type": "object", "required": ["asset_id", "deck_id", "slide_number", "label", "what_it_is", "path", "sha256", "approval_scope", "context_status", "claim_refs", "cue_refs", "evidence_state"], "properties": {"asset_id": {"type": "string"}, "deck_id": {"type": "string"}, "slide_number": {"type": ["integer", "null"]}, "label": {"type": "string"}, "what_it_is": {"type": "string"}, "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}, "approval_scope": {"type": "string"}, "context_status": {"type": "string"}, "claim_refs": {"type": "array", "items": {"type": "string"}}, "cue_refs": {"type": "array", "items": {"type": "string"}}, "evidence_state": {"enum": ["production_ready", "context_crop_review_only"]}}},
    "scene": {"type": "object", "required": ["scene_id", "title", "start_s", "end_s", "cue_count", "claim_refs", "existing_world_asset_ids", "evidence_status_counts", "cadence_turn_count", "new_world_art_gap_count"], "properties": {"scene_id": {"type": "string"}, "title": {"type": "string"}, "start_s": {"type": "number"}, "end_s": {"type": "number"}, "cue_count": {"type": "integer", "minimum": 1}, "claim_refs": {"type": "array", "items": {"type": "string"}}, "existing_world_asset_ids": {"type": "array", "items": {"type": "string"}}, "evidence_status_counts": {"type": "object", "additionalProperties": {"type": "integer"}}, "cadence_turn_count": {"type": "integer", "minimum": 0}, "new_world_art_gap_count": {"type": "integer", "minimum": 0}}},
    "segment": {"type": "object", "required": ["asset_id", "start_s", "end_s", "cue_ids", "duration_s"], "properties": {"asset_id": {"type": "string"}, "start_s": {"type": "number"}, "end_s": {"type": "number"}, "cue_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "duration_s": {"type": "number", "exclusiveMinimum": 0}}},
    "turn": {"type": "object", "required": ["turn_id", "scene_id", "parent_asset_id", "at_s", "state", "match_basis", "candidate_world_asset", "requires_editorial_acceptance"], "properties": {"turn_id": {"type": "string"}, "scene_id": {"type": "string"}, "parent_asset_id": {"type": "string"}, "at_s": {"type": "number"}, "state": {"enum": ["sentence_native_candidate", "scene_authority_candidate", "new_world_art_gap"]}, "match_basis": {"type": "string"}, "candidate_world_asset": {"type": ["object", "null"]}, "requires_editorial_acceptance": {"const": true}}},
    "candidate": {"type": "object", "required": ["asset_id", "deck_id", "slide_number", "sha256", "path", "score", "match_terms", "match_basis", "action", "evidence_state"], "properties": {"asset_id": {"type": "string"}, "deck_id": {"type": "string"}, "slide_number": {"type": ["integer", "null"]}, "sha256": {"$ref": "#/$defs/hash"}, "path": {"type": "string"}, "score": {"type": "integer", "minimum": 1}, "match_terms": {"type": "array", "items": {"type": "string"}}, "match_basis": {"type": "string"}, "action": {"const": "review_crop_or_small_source_surface"}, "evidence_state": {"enum": ["production_ready", "context_crop_review_only"]}}},
    "cue": {"type": "object", "required": ["cue_id", "beat_id", "scene_id", "start_s", "end_s", "frame_range", "excerpt", "claim_refs", "active_world_plate", "evidence_status", "evidence_reason", "requires_source_surface", "candidate_evidence", "candidate_slot_status", "maximum_simultaneous_evidence", "maximum_sequential_evidence", "requires_editorial_acceptance"], "properties": {"cue_id": {"type": "string"}, "beat_id": {"type": "string"}, "scene_id": {"type": "string"}, "start_s": {"type": "number"}, "end_s": {"type": "number"}, "frame_range": {"type": "object", "required": ["fps", "start_frame", "end_frame"], "properties": {"fps": {"const": 30}, "start_frame": {"type": "integer", "minimum": 0}, "end_frame": {"type": "integer", "minimum": 1}}}, "excerpt": {"type": "string"}, "claim_refs": {"type": "array", "items": {"type": "string"}}, "active_world_plate": {"type": "object", "required": ["asset_id", "semantic_action"], "properties": {"asset_id": {"type": "string"}, "semantic_action": {"type": "string"}}}, "evidence_status": {"enum": ["existing_context_needed", "source_pack_needed", "manual_only"]}, "evidence_reason": {"type": "string"}, "requires_source_surface": {"type": "boolean"}, "candidate_evidence": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/candidate"}}, "candidate_slot_status": {"const": "requires_reviewed_plate_profile"}, "maximum_simultaneous_evidence": {"const": 2}, "maximum_sequential_evidence": {"const": 3}, "requires_editorial_acceptance": {"const": true}}}
  }
}
