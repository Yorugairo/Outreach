{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outreach-program.internal/schemas/plate-layout-profiles.v1.json",
  "title": "Plate Layout Profiles v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profiles", "default_profile_id", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "plate_layout_profiles.v1"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schema_version", "profile_id", "status", "artifact_hash"],
        "properties": {
          "schema_version": {"const": "plate_layout_profile.v1"},
          "profile_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
          "status": {"enum": ["reviewed", "experimental", "manual_only"]},
          "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "default_profile_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
