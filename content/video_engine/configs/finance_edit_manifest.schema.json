{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "finance_edit_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "brief_hash", "claim_ledger_hash", "audio_sha256", "words_sha256", "cue_sheet_hash", "assets", "charts", "motion_presets", "review_state", "render_eligible", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "finance_edit_manifest.v1"}, "episode_id": {"type": "string"},
    "brief_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "claim_ledger_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "research_supplement_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "audio_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "words_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cue_sheet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["cue_id", "asset_id", "sha256"], "properties": {"cue_id": {"type": "string"}, "asset_id": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "charts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["chart_id", "dataset_sha256", "claim_refs", "as_of"], "properties": {"chart_id": {"type": "string"}, "dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "claim_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "as_of": {"type": "string", "format": "date"}}}},
    "motion_presets": {"type": "array", "items": {"type": "string"}}, "review_state": {"enum": ["draft", "operator_approved"]},
    "render_eligible": {"type": "boolean"}, "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
