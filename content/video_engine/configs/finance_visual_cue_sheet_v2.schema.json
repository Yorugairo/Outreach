{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "finance_visual_cue_sheet.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "narration", "caption_safe_band", "short_ranges", "cues", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "finance_visual_cue_sheet.v2"},
    "episode_id": {"type": "string", "minLength": 1},
    "narration": {"$ref": "#/definitions/narration"},
    "caption_safe_band": {"$ref": "#/definitions/caption_safe_band"},
    "short_ranges": {"type": "array", "items": {"$ref": "#/definitions/short_range"}},
    "cues": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/cue"}},
    "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "definitions": {
    "narration": {
      "type": "object", "additionalProperties": false,
      "required": ["audio_sha256", "words_sha256", "word_count", "duration_s"],
      "properties": {
        "audio_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "words_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "word_count": {"type": "integer", "minimum": 1},
        "duration_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "caption_safe_band": {
      "type": "object", "additionalProperties": false,
      "required": ["top", "bottom"],
      "properties": {
        "top": {"type": "number", "minimum": 0.84, "maximum": 0.94},
        "bottom": {"type": "number", "minimum": 0.9, "maximum": 1}
      }
    },
    "short_range": {
      "type": "object", "additionalProperties": false,
      "required": ["short_id", "start_word", "end_word", "start_s", "end_s"],
      "properties": {
        "short_id": {"type": "string", "minLength": 1},
        "start_word": {"type": "integer", "minimum": 0},
        "end_word": {"type": "integer", "minimum": 0},
        "start_s": {"type": "number", "minimum": 0},
        "end_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "cue": {
      "type": "object", "additionalProperties": false,
      "required": ["cue_id", "start_word", "end_word", "start_s", "end_s", "excerpt", "claim_refs", "state_type", "visual_world", "call_cue_id", "representation_mode", "semantic_target", "entry_action", "micro_events", "exit_transition", "fact_surface", "evidence_surface_ids", "short_membership"],
      "properties": {
        "cue_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "start_word": {"type": "integer", "minimum": 0},
        "end_word": {"type": "integer", "minimum": 0},
        "start_s": {"type": "number", "minimum": 0},
        "end_s": {"type": "number", "exclusiveMinimum": 0},
        "excerpt": {"type": "string", "minLength": 1},
        "claim_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "state_type": {"enum": ["narrative", "mechanism", "evidence", "transition"]},
        "visual_world": {"enum": ["story", "mechanism", "evidence"]},
        "call_cue_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "representation_mode": {"enum": ["literal_evidence", "accurate_mechanism", "declared_metaphor"]},
        "semantic_target": {
          "type": "object", "additionalProperties": false,
          "required": ["subject", "relationship", "viewer_takeaway", "required_visual_anchors", "prohibited_implications", "prior_state", "next_state"],
          "properties": {
            "subject": {"type": "string", "minLength": 3},
            "relationship": {"type": "string", "minLength": 3},
            "viewer_takeaway": {"type": "string", "minLength": 8},
            "required_visual_anchors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
            "prohibited_implications": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
            "prior_state": {"type": ["string", "null"]},
            "next_state": {"type": ["string", "null"]}
          }
        },
        "entry_action": {"type": "string", "minLength": 3},
        "micro_events": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["at_s", "action"], "properties": {"at_s": {"type": "number", "minimum": 0}, "action": {"type": "string", "minLength": 3}}}},
        "exit_transition": {"type": "string", "minLength": 3},
        "fact_surface": {"type": ["string", "null"]},
        "evidence_surface_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
        "short_membership": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
