{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Higgsfield audio-driven block plan",
  "type": "object",
  "required": ["schema_version", "coverage_plan_hash", "generated_plate_batch_hash", "coverage_slot_count", "block_count", "blocks", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "higgsfield_audio_blocks.v1"},
    "coverage_plan_hash": {"type": "string", "minLength": 1},
    "generated_plate_batch_hash": {"type": "string", "minLength": 1},
    "art_bible_hash": {"type": "string"},
    "storyboard_hash": {"type": "string"},
    "coverage_slot_count": {"type": "integer", "minimum": 1},
    "block_count": {"const": 60},
    "provider_duration_s": {"const": 10},
    "blocks": {"type": "array", "minItems": 60, "maxItems": 60, "items": {"$ref": "#/$defs/block"}},
    "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": ["block_id", "order", "coverage_slot_ids", "narration_excerpt", "narration_hash", "duration_s", "provider_duration_s", "plate", "prompt", "negative_prompt", "audio", "render_eligible"],
      "properties": {
        "block_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "order": {"type": "integer", "minimum": 1, "maximum": 60},
        "coverage_slot_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "narration_excerpt": {"type": "string", "minLength": 1},
        "narration_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "provider_duration_s": {"const": 10},
        "plate": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
        "prompt": {"type": "string", "minLength": 1},
        "negative_prompt": {"type": "string", "minLength": 1},
        "audio": {"type": "object", "required": ["required", "source", "generate_audio"], "properties": {"required": {"const": true}, "source": {"const": "elevenlabs"}, "generate_audio": {"const": false}}},
        "render_eligible": {"const": false}
      }
    }
  }
}
