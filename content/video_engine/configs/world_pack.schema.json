{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://outreach-program.internal/schemas/world-pack-library.v1.json",
  "title": "World Pack Library v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "communication_grammar_hash", "asset_map_id", "packs", "render_eligible", "artifact_hash"],
  "properties": {
    "schema_version": {"const": "world_pack_library.v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "communication_grammar_hash": {"$ref": "#/definitions/hash"},
    "asset_map_id": {"type": "string", "minLength": 1},
    "packs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "episodes", "research_state", "reuse_priority", "narrative_functions", "style_key_id", "style_pack_id", "plates", "ambient_candidates", "entry_motif_ids", "exit_motif_ids", "prompt_core", "negative_constraints", "generation_status", "render_eligible"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "label": {"type": "string", "minLength": 1},
          "episodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^episode-[1-3]$"}},
          "research_state": {"enum": ["approved", "mixed", "question_only"]},
          "reuse_priority": {"type": "integer", "minimum": 1, "maximum": 5},
          "narrative_functions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "style_key_id": {"type": "string", "minLength": 1},
          "style_pack_id": {"type": "string", "minLength": 1},
          "plates": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["view", "composition", "character_staging", "fact_anchors"],
              "properties": {
                "view": {"enum": ["master_establishing", "clean_background", "medium_character", "detail_prop", "entry_frame", "exit_frame"]},
                "composition": {"type": "string", "minLength": 1},
                "character_staging": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "fact_anchors": {"type": "array", "items": {"type": "string", "minLength": 1}}
              }
            }
          },
          "ambient_candidates": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "entry_motif_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "exit_motif_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "prompt_core": {"type": "string", "minLength": 40},
          "negative_constraints": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
          "generation_status": {"enum": ["planned", "blocked_research", "candidate", "approved"]},
          "render_eligible": {"const": false}
        }
      }
    },
    "render_eligible": {"const": false},
    "artifact_hash": {"$ref": "#/definitions/hash"}
  },
  "definitions": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
