{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://outreach-program.internal/schemas/flow-character-pack.v1.json",
  "title": "Google Flow Character Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "model",
    "id",
    "episode_id",
    "art_bible_id",
    "art_bible_hash",
    "characters",
    "render_eligible"
  ],
  "properties": {
    "schema_version": {"const": "flow_character_pack.v1"},
    "provider": {"const": "google_flow"},
    "model": {"const": "nano-banana-pro"},
    "builder_surface": {"const": "character_builder"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "episode_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "art_bible_id": {"type": "string", "minLength": 1},
    "art_bible_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "role",
          "prompt",
          "negative_prompt",
          "reference_views",
          "style_atom_ids",
          "scene_uses",
          "rights_policy",
          "render_eligible"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "label": {"type": "string", "minLength": 1},
          "role": {"enum": ["fictional_learner", "historical_reconstruction", "composite"]},
          "prompt": {"type": "string", "minLength": 80, "maxLength": 4000},
          "negative_prompt": {"type": "string", "minLength": 20, "maxLength": 2000},
          "reference_views": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {"enum": ["front", "three_quarter", "profile", "full_body", "expression_sheet", "prop_detail"]}
          },
          "style_atom_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "scene_uses": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "rights_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_kind", "likeness_status", "label_as_illustration"],
            "properties": {
              "source_kind": {"const": "generated_original"},
              "likeness_status": {"enum": ["fictional", "historical_reconstruction", "composite"]},
              "label_as_illustration": {"const": true}
            }
          },
          "reference_asset_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "render_eligible": {"const": false}
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generate_character_sheet_first": {"const": true},
        "operator_review_required": {"const": true},
        "ingredients_to_video_requires_approved_reference": {"const": true},
        "provider_output_render_eligible": {"const": false}
      }
    },
    "render_eligible": {"const": false},
    "artifact_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
