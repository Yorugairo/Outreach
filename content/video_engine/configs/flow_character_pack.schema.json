{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://outreach-program.internal/schemas/flow-character-pack.v1.json",
  "title": "Google Flow Character Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "model",
    "id",
    "episode_id",
    "art_bible_id",
    "art_bible_hash",
    "characters",
    "render_eligible"
  ],
  "properties": {
    "schema_version": {
      "const": "flow_character_pack.v1"
    },
    "provider": {
      "const": "google_flow"
    },
    "model": {
      "const": "nano-banana-pro"
    },
    "builder_surface": {
      "const": "character_builder"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "art_bible_id": {
      "type": "string",
      "minLength": 1
    },
    "art_bible_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "role",
          "prompt",
          "negative_prompt",
          "reference_views",
          "style_atom_ids",
          "scene_uses",
          "rights_policy",
          "render_eligible"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "fictional_learner",
              "fictional_presenter",
              "historical_reconstruction",
              "composite"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 80,
            "maxLength": 4000
          },
          "negative_prompt": {
            "type": "string",
            "minLength": 20,
            "maxLength": 2000
          },
          "reference_views": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "front",
                "three_quarter",
                "profile",
                "back",
                "full_body",
                "expression_sheet",
                "pose_sheet",
                "prop_detail"
              ]
            }
          },
          "style_atom_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scene_uses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rights_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_kind",
              "likeness_status",
              "label_as_illustration"
            ],
            "properties": {
              "source_kind": {
                "const": "generated_original"
              },
              "likeness_status": {
                "enum": [
                  "fictional",
                  "historical_reconstruction",
                  "composite"
                ]
              },
              "label_as_illustration": {
                "const": true
              }
            }
          },
          "reference_asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "render_eligible": {
            "const": false
          },
          "expressions": {
            "type": "array",
            "minItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z_-]*$"
            },
            "description": "The head-only expression row of the model sheet, enumerated so the sheet is ordered, not whatever a generation returns. Doubles as the cutout rig's HeadSlot enumeration (43 §43.6)."
          },
          "poses": {
            "type": "array",
            "minItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z_-]*$"
            },
            "description": "The full-body pose row of the model sheet. Doubles as the rig's TorsoSlot / HandSlot enumeration."
          },
          "variant": {
            "enum": [
              "retention",
              "acquisition"
            ],
            "description": "retention = the full-detail character for world plates and long form; acquisition = the same person at thumbnail abstraction (53 §53.10)."
          },
          "variant_of": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "For an acquisition variant: the id of the retention character it simplifies. Must name another character in this pack."
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generate_character_sheet_first": {
          "const": true
        },
        "operator_review_required": {
          "const": true
        },
        "ingredients_to_video_requires_approved_reference": {
          "const": true
        },
        "provider_output_render_eligible": {
          "const": false
        }
      }
    },
    "render_eligible": {
      "const": false
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
