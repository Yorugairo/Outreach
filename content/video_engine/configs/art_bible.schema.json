{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://outreach-program.internal/schemas/art-bible.v1.json",
  "title": "Renderer Art Bible v1",
  "description": "Internal style atoms and deterministic rendering rules. No third-party asset or creator provenance is permitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "study_ref",
    "render_policy",
    "palette",
    "typography",
    "style_atoms",
    "composition",
    "motion"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "art_bible.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "study_ref": {
      "$ref": "#/definitions/studyRef"
    },
    "render_policy": {
      "$ref": "#/definitions/renderPolicy"
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 4,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "weight", "case", "tracking"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "caption_font": { "type": "string", "minLength": 1 },
        "measurement_font": { "type": "string", "minLength": 1 },
        "caption_source": { "type": "string", "minLength": 1 },
        "measurement_source": { "type": "string", "minLength": 1 },
        "weight": { "type": "string", "enum": ["regular", "medium", "semibold", "bold"] },
        "case": { "type": "string", "enum": ["sentence", "title", "upper"] },
        "tracking": { "type": "number", "minimum": -0.2, "maximum": 0.5 },
        "safe_chars": { "type": "integer", "minimum": 1 }
      }
    },
    "style_atoms": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/definitions/styleAtom"
      }
    },
    "composition": {
      "$ref": "#/definitions/composition"
    },
    "motion": {
      "$ref": "#/definitions/motion"
    },
    "signature": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "definitions": {
    "studyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hash"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "renderPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_domain", "allow_external_assets", "allow_creator_imitation"],
      "properties": {
        "input_domain": { "const": "internal_style_atoms" },
        "allow_external_assets": { "const": false },
        "allow_creator_imitation": { "const": false },
        "allowed_asset_kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["vector_geometry", "flat_fill", "typography", "diagram_overlay", "mat_texture"]
          }
        }
      }
    },
    "styleAtom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "description", "tokens"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "type": "string",
          "enum": ["field", "cast", "contact", "diagram", "type", "transition", "texture", "accent"]
        },
        "description": { "type": "string", "minLength": 1 },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "type": ["string", "number", "boolean", "array"]
            }
          }
        },
        "applies_to": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe_margin", "anchor_grid", "functions"],
      "properties": {
        "safe_margin": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.25 },
        "anchor_grid": { "type": "string", "enum": ["rule_of_thirds", "four_anchor", "centerline"] },
        "functions": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": { "$ref": "#/definitions/functionRule" }
          }
        },
        "max_repeated_framing": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    },
    "functionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framing", "atom_ids"],
      "properties": {
        "framing": { "type": "string", "minLength": 1 },
        "atom_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "emphasis": { "type": "string", "minLength": 1 }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_order", "easing", "transition_motifs"],
      "properties": {
        "phase_order": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "enum": ["anticipation", "action", "contact", "recovery", "hold"]
          }
        },
        "easing": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": { "type": "string", "minLength": 1 }
          }
        },
        "transition_motifs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
