{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://outreach-program.internal/schemas/creative-inventory.v1.json",
  "title": "Creative Inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "roots",
    "items",
    "summary",
    "render_eligible",
    "artifact_hash"
  ],
  "properties": {
    "schema_version": {"const": "creative_inventory.v1"},
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "default_classification"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "path": {"type": "string", "minLength": 1},
          "default_classification": {"$ref": "#/definitions/classification"}
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root_id",
          "relative_path",
          "sha256",
          "size_bytes",
          "media_kind",
          "classification",
          "manifest_asset_ids"
        ],
        "properties": {
          "root_id": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/definitions/hash"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "extension": {"type": "string"},
          "media_kind": {
            "enum": ["image", "vector", "video", "audio"]
          },
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "duration_s": {"type": "number", "exclusiveMinimum": 0},
          "classification": {"$ref": "#/definitions/classification"},
          "manifest_asset_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "notes": {"type": "string"}
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_items", "by_classification", "by_media_kind"],
      "properties": {
        "total_items": {"type": "integer", "minimum": 0},
        "by_classification": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "by_media_kind": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "render_eligible": {"const": false},
    "artifact_hash": {"$ref": "#/definitions/hash"}
  },
  "definitions": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "classification": {
      "enum": [
        "approved_reusable",
        "reference_only",
        "rejected",
        "superseded",
        "unknown"
      ]
    }
  }
}
